{
  "name": "campusos-backend",
  "version": "1.0.0",
  "description": "CampusOS - Smart Campus Management Platform. REST API.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --runInBand",
    "db:schema": "psql -d $npm_config_db -f ../db/schema.sql",
    "db:seed": "psql -d $npm_config_db -f ../db/seed.sql",
    "db:reset": "psql -d $npm_config_db -f ../db/reset.sql -f ../db/schema.sql -f ../db/seed.sql",
    "report:export": "node scripts/export-report.js",
    "lock:rebuild": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
