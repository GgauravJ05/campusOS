# ============================================================
# CampusOS API - copy to backend/.env and fill in.
# backend/.env is git-ignored; never commit real credentials.
# ============================================================

NODE_ENV=development

# macOS note: port 5000 is taken by the AirPlay Receiver, which answers 403
# to everything. Either turn it off in System Settings > General > AirDrop &
# Handoff, or use a different port here.
PORT=5050

# --- Database ------------------------------------------------
# Either set DATABASE_URL, or the discrete DB_* values below.
# Matches `docker compose up -d` (see docker-compose.yml).
# DATABASE_URL=postgresql://postgres:postgres@localhost:55432/campusos
DB_HOST=localhost
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=campusos
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# --- Auth ----------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=campusos
BCRYPT_ROUNDS=12
# Name of the httpOnly refresh-token cookie.
REFRESH_COOKIE_NAME=campusos_rt

# Only these domains may self-register (comma-separated; empty = any).
ALLOWED_EMAIL_DOMAINS=mmcoe.edu.in
# Where the web app lives - used for links inside emails.
APP_URL=http://localhost:5173

# One-time codes (email verification, password reset)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Brute-force protection: lock sign-in after N failures for M minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Email ---------------------------------------------------
# Leave SMTP_HOST empty in development: emails (with their codes) are
# printed to the API log instead of sent. Required in production.
# Gmail example: smtp.gmail.com, port 465, SMTP_SECURE=true, app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=CampusOS <no-reply@campusos.local>

# --- Security ------------------------------------------------
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# --- Reminders (FR19) ----------------------------------------
# The background worker that sends the 2-day and 2-hour reminders. The
# offsets themselves are configurable per deployment in system_settings
# (reminder.first_offset_hours, reminder.second_offset_hours).
REMINDER_WORKER_ENABLED=true
REMINDER_INTERVAL_MS=300000

# --- Logging / lifecycle -------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
SHUTDOWN_TIMEOUT_MS=10000

# --- Testing -------------------------------------------------
# Set for the database-backed suites in tests/integration. Without it,
# those suites skip and `npm test` still passes with no PostgreSQL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55433/campusos_test
