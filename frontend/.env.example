# CampusOS frontend - copy to frontend/.env.local if you need to change anything.
# Vite only exposes variables prefixed with VITE_ to the browser,
# so never put a secret in this file.

# Where the browser sends API calls. Keep "/api" in development: the dev
# server proxies it, so the refresh-token cookie stays first-party.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api (development only).
VITE_API_PROXY_TARGET=http://localhost:5050
